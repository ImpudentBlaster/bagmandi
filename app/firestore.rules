rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function enquiryBuyer(enquiryId) {
      return get(/databases/$(database)/documents/enquiries/$(enquiryId)).data.buyerId;
    }

    // ── Users ──
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['buyer', 'manufacturer', 'guest'];
      // Separate allows so admin updates (verify/disable) always work
      allow update: if isAdmin();
      allow update: if isOwner(userId)
        && (!('role' in request.resource.data)
          || request.resource.data.role == resource.data.role
          || request.resource.data.role in ['buyer', 'manufacturer', 'guest']);
      allow delete: if isAdmin();
    }

    // ── Enquiries ──
    match /enquiries/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn() && (
        isAdmin()
        || resource.data.buyerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quoteCount', 'status'])
      );
      allow delete: if isAdmin() || resource.data.buyerId == request.auth.uid;
    }

    // ── Quotes ──
    match /quotes/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.manufacturerId == request.auth.uid;
      allow update: if signedIn() && (
        isAdmin()
        || resource.data.manufacturerId == request.auth.uid
        || enquiryBuyer(resource.data.enquiryId) == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── Orders ──
    // Separate allow lines so admin unfiltered list/count is allowed.
    match /orders/{id} {
      allow get: if isAdmin();
      allow get: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow get: if signedIn() && resource.data.manufacturerId == request.auth.uid;

      allow list: if isAdmin();
      allow list: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow list: if signedIn() && resource.data.manufacturerId == request.auth.uid;

      allow create: if isAdmin();
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;

      allow update: if isAdmin();
      allow update: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow update: if signedIn() && resource.data.manufacturerId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ── Marketplace ──
    match /marketplace/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin();
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAdmin();
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    // ── PP rates ──
    match /pp_rates/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── In-app notifications ──
    match /notifications/{id} {
      allow get: if isAdmin();
      allow get: if signedIn() && resource.data.userId == request.auth.uid;

      allow list: if isAdmin();
      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'title', 'body', 'createdAt'])
        && request.resource.data.userId is string;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isAdmin();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Banners (admin CMS) ──
    match /banners/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Chats ──
    // get on a missing chat must be allowed so clients can create the first thread.
    // (resource is null when the doc does not exist — old rule blocked Contact.)
    match /chats/{chatId} {
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasAny(['participantIds'])
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.participantIds
        || (
          request.resource.data.keys().hasAny(['participantIds'])
          && request.auth.uid in request.resource.data.participantIds
          && request.resource.data.participantIds.size() == 2
        )
      );

      match /messages/{msgId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 2000;
        allow update, delete: if false;
      }
    }
  }
}
